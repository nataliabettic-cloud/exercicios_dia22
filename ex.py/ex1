def calcularTotalGols(gols):
    total = 0

    for gol in gols:
        total = total + gol

    return total

def calcularMediaGols(gols):
    total = calcularTotalGols(gols)
    media = total / 5

    return media

def encontrarArtilheiros(jogadores, gols):
    maior = gols[0]

    for gol in gols:
        if gol > maior:
            maior = gol

    artilheiros = []

    for i in range(5):
        if gols[i] == maior:
            artilheiros.append(jogadores[i])

    return artilheiros

def mostrarRelatorio(jogadores, gols):
    total = calcularTotalGols(gols)
    media = calcularMediaGols(gols)
    artilheiros = encontrarArtilheiros(jogadores, gols)

    print("\n===== RELATÓRIO =====")

    print("\nJogadores e gols:")

    for i in range(5):
        print(jogadores[i], "-", gols[i], "gol(s)")

    print("\nTotal de gols:", total)
    print("Média de gols:", media)

    print("\nJogadores que marcaram mais que a média:")

    encontrou = False

    for i in range(5):
        if gols[i] > media:
            print(jogadores[i])
            encontrou = True

    if encontrou == False:
        print("Nenhum jogador marcou mais que a média.")

    print("\nArtilheiro(s):")

    for jogador in artilheiros:
        print(jogador)

    if len(artilheiros) > 1:
        print("Houve empate na artilharia.")
    else:
        print("Não houve empate na artilharia.")

def cadastrarJogadores():
    jogadores = []
    gols = []

    for i in range(5):

        nome = input("Digite o nome do jogador: ")

        while nome == "":
            print("O nome não pode ficar vazio.")
            nome = input("Digite o nome do jogador: ")

        while nome in jogadores:
            print("Esse jogador já foi cadastrado.")
            nome = input("Digite outro nome: ")

        jogadores.append(nome)

        quantidade = int(input("Digite a quantidade de gols: "))

        while quantidade < 0:
            print("A quantidade de gols não pode ser negativa.")
            quantidade = int(input("Digite a quantidade de gols: "))

        gols.append(quantidade)

    return jogadores, gols

def main():
    jogadores = []
    gols = []

    while True:
        print("\n===== CAMPEONATO ESCOLAR =====")
        print("1 - Cadastrar jogadores")
        print("2 - Mostrar relatório")
        print("3 - Encerrar")

        opcao = input("Escolha uma opção: ")

        if opcao == "1":
            jogadores, gols = cadastrarJogadores()
            print("Jogadores cadastrados!")

        elif opcao == "2":
            if len(jogadores) == 5:
                mostrarRelatorio(jogadores, gols)
            else:
                print("Cadastre os 5 jogadores primeiro.")

        elif opcao == "3":
            print("Programa encerrado.")
            break

        else:
            print("Opção inválida.")


main()
